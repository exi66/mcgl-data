# Public site info: used in index.html (<title>, description, link previews). Not secret — committed on purpose.
# Full URL of the deployed site with a trailing slash (og:image and og:url need absolute URLs).
VITE_SITE_URL=https://exi66.github.io/mcgl-data/
VITE_SITE_TITLE=mcgl-data
VITE_SITE_DESCRIPTION=Поиск по архиву комментариев и постов форума Minecraft Galaxy

# API addresses are not committed: put them in .env.local (gitignored) for local runs; the Pages workflow takes them
# from repo secrets.
# VITE_API_URL=<PostgREST URL>
# VITE_FORUM_PROXY_URL=<CORS proxy for forum tooltips, mcgl-data-api/forum-proxy; without it tooltips are off>
